# ---------------------------------------------------------------------------
# Meta-Pro backend environment
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Provider API keys
# MISTRAL_API_KEY — primary LLM (instructor / litellm) AND media transcription
# (Voxtral speech-to-text). Required for uploads to work.
MISTRAL_API_KEY=
# GROQ_API_KEY — OPTIONAL. Used only as the emergency LLM fallback when the
# Mistral call fails. Media transcription never uses Groq. Leave empty for a
# Mistral-only setup.
GROQ_API_KEY=
# MISTRAL_TRANSCRIPTION_MODEL — Mistral Voxtral model used for media
# transcription. Pin an explicit version (e.g. voxtral-mini-2602) for
# reproducibility.
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest

# LLM routing — Mistral primary, Groq fallback (LiteLLM failover group)
PRIMARY_LLM_MODEL=mistral/mistral-large-latest
FALLBACK_LLM_MODEL=groq/llama-3.3-70b-versatile

# Infrastructure
# ---------------------------------------------------------------------------
# ENVIRONMENT — "development" (default) or "production".
#   - development: CORS allows any origin (wildcard) and no startup checks.
#   - production:  CORS is restricted to ALLOWED_ORIGINS, and the app refuses
#     to start unless DATABASE_URL and MISTRAL_API_KEY are set (see config.py).
ENVIRONMENT=development

# DATABASE_URL — Supabase PostgreSQL (persistent LangGraph checkpointing).
# REQUIRED in production (ENVIRONMENT=production) — the app will not start
# without it. Leave empty only for local development (SQLite / in-memory
# fallback).
#
# Supabase is the ONLY supported Postgres host. Local Docker PostgreSQL is
# intentionally NOT provisioned (see docker-compose.yml — it only runs Redis).
#
# The value below is the Supabase **IPv4 connection pooler (Supavisor)**
# format — the only pooler that works from IPV4-only networks (e.g. local
# dev machines without IPv6).
#
#   - Host:      [PROJECT-REF].pooler.supabase.com      (replace the brackets)
#   - User:      postgres.[PROJECT-REF]                 (your project ref)
#   - Password:  your Supabase database password
#   - Port:      6543  →  Supavisor TRANSACTION pooler (recommended for
#                short-lived / serverless connections; prepared statements
#                are disabled automatically by the backend).
#                Port 5432  →  Supavisor SESSION pooler (long-lived
#                connections only; not used by this app).
#   - sslmode=require is required by Supabase and enforced by the backend
#     for any *.supabase.com host, even if omitted here.
#
# Leave empty for quick local testing — the backend falls back to a local
# SQLite file, then to an in-memory MemorySaver (no external services).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# REDIS_URL — optional local Redis (see docker-compose.yml). Used only for
# step-bound memory / queueing during local development. If Redis is not
# running, the backend keeps state in memory instead.
REDIS_URL=redis://localhost:6379/0

# Runtime guardrails
MAX_STEPS=10

# Resilience / rate limiting
# ---------------------------------------------------------------------------
# MIN_LLM_INTERVAL_SECONDS — minimum seconds between LLM provider calls.
# One run fires ~13 sequential calls, so pacing keeps a single-user server
# under a provider's requests-per-minute quota (Mistral free tier is ~60 RPM
# with tight per-minute token ceilings). Runs get real content instead of
# rate-limited placeholders. Tune per key; 0 disables pacing.
# A run at 15s pacing takes ~2-3 min; drop to 5s if your key has headroom.
MIN_LLM_INTERVAL_SECONDS=15
# MAX_RETRY_AFTER_SECONDS — upper bound (seconds) for honouring a provider's
# Retry-After hint before retrying a rate-limited call.
MAX_RETRY_AFTER_SECONDS=60
# BREAKER_COOLDOWN_SECONDS — how long a failed provider stays on cooldown
# (app-level circuit breaker AND the LiteLLM Router deployment cooldown).
BREAKER_COOLDOWN_SECONDS=120

# API / CORS — allowed browser origins (Vercel frontend + local dev)
# ---------------------------------------------------------------------------
# Comma-separated origins enforced in production (ENVIRONMENT=production).
# Set this to your deployed Vercel frontend domain(s), e.g.
#   ALLOWED_ORIGINS=https://meta-pro.vercel.app
# In development the API serves a wildcard origin instead, so this value is
# only used when ENVIRONMENT=production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
